# ================================
# Godot 4
# ================================

# Godot editor cache and imported asset data
# Automatically regenerated by Godot and should not be shared
.godot/

# ================================
# Exported Builds
# ================================

# Exported game files
# These are generated builds, not source files
/export/
/exports/
/builds/

# ================================
# Operating System Files
# ================================

# macOS metadata
# Created automatically by macOS Finder
.DS_Store

# Windows thumbnail cache
# Stores local thumbnail information
Thumbs.db

# Windows folder settings
# Stores local Explorer configuration
Desktop.ini

# ================================
# IDE / Editor Files
# ================================

# Visual Studio Code settings
# Usually contains machine/user-specific configuration
.vscode/

# JetBrains / Rider settings
# Contains local IDE configuration
.idea/

# ================================
# Temporary Files
# ================================

# Temporary files
# Created by editors or other applications
*.tmp
*.temp

# Backup files
# Usually created automatically when editing files
*.bak
*~

# Vim/Unix swap files
# Temporary files created while editing
*.swp
*.swo

# ================================
# Logs
# ================================

# Log files
# Runtime/debug logs are generated locally
*.log